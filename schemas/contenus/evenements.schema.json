{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enclume.local/schemas/contenus/evenements.schema.json",
  "title": "contenus/evenements.json — événements aléatoires (GDD §12.3)",
  "description": "Champs listés requis ; champs supplémentaires tolérés.",
  "type": "object",
  "required": [
    "schema_version",
    "entrees"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "../commun.schema.json#/$defs/schema_version"
    },
    "entrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "contexte",
          "type",
          "enjeu",
          "poids"
        ],
        "properties": {
          "id": {
            "$ref": "../commun.schema.json#/$defs/slug"
          },
          "contexte": {
            "enum": [
              "voyage",
              "repos",
              "ville",
              "breche",
              "nuit"
            ]
          },
          "rang_min": {
            "$ref": "../commun.schema.json#/$defs/rang"
          },
          "rang_max": {
            "$ref": "../commun.schema.json#/$defs/rang"
          },
          "saisons": {
            "type": "array",
            "items": {
              "$ref": "../commun.schema.json#/$defs/saison"
            }
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "enjeu": {
            "type": "string",
            "minLength": 1
          },
          "acteurs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "complications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "poids": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Poids du tirage pondéré."
          }
        }
      }
    }
  }
}
