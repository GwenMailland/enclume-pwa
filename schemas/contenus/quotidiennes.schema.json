{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enclume.local/schemas/contenus/quotidiennes.schema.json",
  "title": "contenus/quotidiennes.json",
  "description": "Champs listés requis ; champs supplémentaires tolérés.",
  "type": "object",
  "required": [
    "schema_version",
    "entrees"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "../commun.schema.json#/$defs/schema_version"
    },
    "entrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "texte",
          "objectif",
          "unite",
          "poids"
        ],
        "properties": {
          "id": {
            "$ref": "../commun.schema.json#/$defs/id_quo"
          },
          "texte": {
            "type": "string",
            "minLength": 1
          },
          "objectif": {
            "type": "integer",
            "minimum": 1
          },
          "unite": {
            "type": "string",
            "minLength": 1
          },
          "stat": {
            "$ref": "../commun.schema.json#/$defs/stat"
          },
          "rang_min": {
            "$ref": "../commun.schema.json#/$defs/rang"
          },
          "poids": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Poids du tirage pondéré."
          }
        }
      }
    }
  }
}
