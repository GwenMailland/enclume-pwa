{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enclume.local/schemas/contenus/breches.schema.json",
  "title": "contenus/breches.json — types de brèches",
  "description": "Champs listés requis ; champs supplémentaires tolérés.",
  "type": "object",
  "required": [
    "schema_version",
    "entrees"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "../commun.schema.json#/$defs/schema_version"
    },
    "entrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom_gabarit",
          "rang_min",
          "rang_max",
          "etages_min",
          "etages_max",
          "debordement_jours",
          "poids"
        ],
        "properties": {
          "id": {
            "$ref": "../commun.schema.json#/$defs/id_brc"
          },
          "nom_gabarit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rang_min": {
            "$ref": "../commun.schema.json#/$defs/rang"
          },
          "rang_max": {
            "$ref": "../commun.schema.json#/$defs/rang"
          },
          "etages_min": {
            "type": "integer",
            "minimum": 1
          },
          "etages_max": {
            "type": "integer",
            "minimum": 1
          },
          "types_ennemis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boss": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "debordement_jours": {
            "type": "integer",
            "minimum": 1
          },
          "recompenses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "poids": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Poids du tirage pondéré."
          }
        }
      }
    }
  }
}
