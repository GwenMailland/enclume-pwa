{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enclume.local/schemas/contenus/batiments.schema.json",
  "title": "contenus/batiments.json",
  "description": "Champs listés requis ; champs supplémentaires tolérés.",
  "type": "object",
  "required": [
    "schema_version",
    "entrees"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "../commun.schema.json#/$defs/schema_version"
    },
    "entrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom",
          "role",
          "niveaux"
        ],
        "properties": {
          "id": {
            "$ref": "../commun.schema.json#/$defs/id_bat"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "niveaux": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "niveau",
                "cout",
                "duree_jours",
                "effet"
              ],
              "properties": {
                "niveau": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "cout": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "../commun.schema.json#/$defs/ressource_ville"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "duree_jours": {
                  "type": "integer",
                  "minimum": 1
                },
                "effet": {
                  "type": "string",
                  "minLength": 1
                },
                "palier_min": {
                  "$ref": "../commun.schema.json#/$defs/palier_ville"
                }
              }
            }
          }
        }
      }
    }
  }
}
