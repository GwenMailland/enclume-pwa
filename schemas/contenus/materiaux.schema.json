{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enclume.local/schemas/contenus/materiaux.schema.json",
  "title": "contenus/materiaux.json",
  "description": "Champs listés requis ; champs supplémentaires tolérés.",
  "type": "object",
  "required": [
    "schema_version",
    "entrees"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "../commun.schema.json#/$defs/schema_version"
    },
    "entrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom",
          "rang",
          "proprietes",
          "poids"
        ],
        "properties": {
          "id": {
            "$ref": "../commun.schema.json#/$defs/id_mat"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "rang": {
            "$ref": "../commun.schema.json#/$defs/rang"
          },
          "proprietes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bonus_forge": {
            "type": "integer"
          },
          "legendaire": {
            "type": "boolean"
          },
          "origine": {
            "type": "string",
            "minLength": 1
          },
          "valeur": {
            "type": "integer",
            "minimum": 0
          },
          "poids": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Poids du tirage pondéré."
          }
        }
      }
    }
  }
}
