{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enclume.local/schemas/contenus/monde/regions.schema.json",
  "title": "contenus/monde/regions.json — gabarits de régions",
  "description": "Champs listés requis ; champs supplémentaires tolérés.",
  "type": "object",
  "required": [
    "schema_version",
    "entrees"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "../../commun.schema.json#/$defs/schema_version"
    },
    "entrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom_gabarit",
          "biomes",
          "rang_min",
          "rang_max",
          "cultures",
          "poids"
        ],
        "properties": {
          "id": {
            "$ref": "../../commun.schema.json#/$defs/slug"
          },
          "nom_gabarit": {
            "type": "string",
            "minLength": 1
          },
          "biomes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rang_min": {
            "$ref": "../../commun.schema.json#/$defs/rang"
          },
          "rang_max": {
            "$ref": "../../commun.schema.json#/$defs/rang"
          },
          "cultures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "../../commun.schema.json#/$defs/slug"
            }
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "accroches": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "poids": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Poids du tirage pondéré."
          }
        }
      }
    }
  }
}
