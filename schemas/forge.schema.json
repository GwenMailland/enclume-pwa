{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enclume.local/schemas/forge.schema.json",
  "title": "forge.json — recettes, maîtrise, historique",
  "description": "Le niveau de Maîtrise de forge est dans perso.json > metiers.forge ; ce fichier porte l'XP de maîtrise.",
  "type": "object",
  "required": ["schema_version", "maitrise_xp", "recettes", "historique", "premieres_qualites"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "commun.schema.json#/$defs/schema_version" },
    "maitrise_xp": { "type": "integer", "minimum": 0 },
    "enclume": {
      "description": "Outil personnel (GDD §9.1).",
      "type": "object",
      "required": ["nom", "bonus"],
      "additionalProperties": false,
      "properties": {
        "nom": { "type": "string" },
        "bonus": { "type": "integer" }
      }
    },
    "recettes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nom", "type", "materiaux", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "commun.schema.json#/$defs/id_rec" },
          "nom": { "type": "string" },
          "type": { "$ref": "commun.schema.json#/$defs/type_objet" },
          "materiaux": { "type": "array", "minItems": 1, "items": { "$ref": "commun.schema.json#/$defs/quantite_materiau" } },
          "heures": { "type": "integer", "minimum": 1, "maximum": 12 },
          "source": { "enum": ["origine", "apprise", "decouverte", "experimentale"] },
          "jour": { "$ref": "commun.schema.json#/$defs/jour" }
        }
      }
    },
    "historique": {
      "description": "Une entrée par tentative de forge, la plus ancienne en premier.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["jour", "session", "experimental", "materiaux", "d20", "total", "qualite", "objet"],
        "additionalProperties": false,
        "properties": {
          "jour": { "$ref": "commun.schema.json#/$defs/jour" },
          "session": { "type": "integer", "minimum": 1 },
          "recette": { "oneOf": [{ "type": "null" }, { "$ref": "commun.schema.json#/$defs/id_rec" }] },
          "experimental": { "type": "boolean" },
          "materiaux": { "type": "array", "items": { "$ref": "commun.schema.json#/$defs/quantite_materiau" } },
          "d20": { "type": "integer", "minimum": 1, "maximum": 20 },
          "total": { "type": "integer" },
          "qualite": { "$ref": "commun.schema.json#/$defs/qualite_forge" },
          "objet": { "oneOf": [{ "type": "null" }, { "$ref": "commun.schema.json#/$defs/id_obj" }], "description": "null si ratée." },
          "nom": { "type": "string" },
          "xp_maitrise": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "premieres_qualites": {
      "description": "Qualités déjà obtenues au moins une fois (bonus d'XP de première, GDD §9.4).",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "commun.schema.json#/$defs/qualite" }
    }
  }
}
